# Copy to .env on the server and fill in. .env is never committed.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"      -> SESSION_SECRET
SESSION_SECRET=
DB_PATH=./data/trip.db
PUBLIC_BASE_URL=https://trip.skyserver1508.org
SESSION_HTTPS_ONLY=true

# Website login: Authentik OAuth2/OpenID provider "trip-web" (confidential client).
# Redirect URI (strict): exactly OIDC_REDIRECT_URI. Scopes: openid email profile.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=https://auth.skyserver1508.org/application/o/trip-web/.well-known/openid-configuration
OIDC_REDIRECT_URI=https://trip.skyserver1508.org/auth/callback

# Claude's connector: a second Authentik provider "trip-claude" (confidential client, signing key selected so tokens are JWTs).
# Redirect URI: https://claude.ai/api/mcp/auth_callback. Put its client id and secret into claude.ai
# (Settings > Connectors > Add custom connector > Advanced settings). MCP_CLIENT_ID is the audience tokens must carry.
MCP_ISSUER=https://auth.skyserver1508.org/application/o/trip-claude/
MCP_CLIENT_ID=

# Fallback only while the OAuth login does not work: a long random value; the connector address becomes
# https://trip.skyserver1508.org/mcp-secret/<value>. Anyone who knows it can read and change everything. Leave empty when not needed.
MCP_SECRET_PATH=
# The Authentik user id (sub) whose trips Claude sees through that fallback address. Without it the address stays closed.
MCP_SECRET_SUB=
